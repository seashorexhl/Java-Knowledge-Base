# ==========================================
# 1. 构建与编译产物 (Maven/Gradle)
# ==========================================
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Kotlin 编译产物
.kotlin

# ==========================================
# 2. 项目特有目录 (非常重要！)
# ==========================================
# 日志文件通常很大且不需要版本控制，必须忽略
logs/
*.log

# 如果 conf 目录下存放的是本地敏感配置(如数据库密码)，建议忽略
# 如果 conf 下是通用模板配置，则保留，按需开启下面这行
# conf/ 

# 临时文件或生成的文件
tmp/
temp/

# ==========================================
# 3. IntelliJ IDEA (JetBrains系列)
# ==========================================
.idea/
# 保留 run configurations 和字典等个人偏好设置（可选）
!.idea/runConfigurations/
!.idea/dictionaries/
*.iws
*.iml
*.ipr
out/

# ==========================================
# 4. Eclipse
# ==========================================
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# ==========================================
# 5. NetBeans
# ==========================================
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ==========================================
# 6. VS Code
# ==========================================
.vscode/
# 除非你想共享团队的工作区设置，否则忽略
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.history*

# ==========================================
# 7. OS 系统文件
# ==========================================
.DS_Store
Thumbs.db